<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Merkato.Launcher.MainWindow"
        Title="MainWindow"
        Width="240"
        Height="400"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border CornerRadius="8" Background="#EEF0EB">
        <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#284B63" CornerRadius="8,8,0,0" Padding="4">
                <Grid ColumnDefinitions="Auto,*,*" VerticalAlignment="Center">
                    <Image Source="/Assets/haveno.ico"
                           Width="24"
                           Height="24"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               FontSize="16"
                               Foreground="#fff"
                               x:Name="Title"
                               VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="2"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Right"
                        x:Name="Nav"
                        Classes="transparent">
                            <materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20" x:Name="Icon"/>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="12" x:Name="Home">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Button Content="Start"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="StartButton"
                            Click="OnStartClick" />

                    <Button Content="Stop"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="StopButton"
                            Click="OnStopClick" />

                    <Button Content="Open browser"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="OpenBrowserButton"
                            Click="OnOpenBrowserClick" />

                    <Button Content="Quit"
                            Classes="quit"
                            Grid.Row="3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnQuitClick"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="12" x:Name="Settings">

            </Border>
        </Grid>
    </Border>
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#153243"/>
            <Setter Property="Foreground" Value="#fff"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff"/>
            <Setter Property="Background" Value="#284B63"/>
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff"/>
            <Setter Property="Background" Value="#4e6b7f"/>
        </Style>

        <Style Selector="Button.quit">
            <Setter Property="Background" Value="#a51929" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>

        <Style Selector="Button.quit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#b03644" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>

        <Style Selector="Button.transparent">
            <Setter Property="Background" Value="transparent"/>
        </Style>
    </Window.Styles>
</Window>
