<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Merkato.Launcher.MainWindow"
        Title="MainWindow"
        Width="240"
        Height="400"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border CornerRadius="8" Background="#EEF0EB">
        <StackPanel Spacing="0">
            <Border Background="#284B63" CornerRadius="8,8,0,0" Padding="4">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Image Source="/Assets/haveno.ico"
                           Width="24"
                           Height="24"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Haveno Web"
                               FontSize="16"
                               Foreground="#fff"
                               VerticalAlignment="Center"/>
                </Grid>                
            </Border>
            <Border Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">
                    <Button Content="Start"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="StartButton"
                            Click="OnStartClick" />

                    <Button Content="Stop"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="StopButton"
                            Click="OnStopClick" />

                    <Button Content="Open browser"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="OpenBrowserButton"
                            Click="OnOpenBrowserClick" />
                </Grid>
            </Border>
            <!--<TextBox x:Name="InputBox" Watermark="." />-->
        </StackPanel>
    </Border>
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#153243"/>
            <Setter Property="Foreground" Value="#fff"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff"/>
            <Setter Property="Background" Value="#284B63"/>
        </Style>
    </Window.Styles>
</Window>
