@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div class="settings-main">
    <div class="info">
        <h5>About</h5>
        <div class="space"></div>
        <div class="about-row">
            <p>Haveno version</p>
            <p>@Model.HavenoVersion</p>
        </div>
        <div class="about-row">
            <p>App version</p>
            <p>@AppConstants.ApplicationVersion</p>
        </div>
        <div class="space"></div>
        <div class="support-links-container">
            <h5>Support links</h5>
            @if (!string.IsNullOrEmpty(AppConstants.GitHubLink))
            {
                <div class="link-container">
                    <img src="/icons/github.svg" />
                    <a href="@AppConstants.GitHubLink">Source code</a>
                </div>
            }
            @if (!string.IsNullOrEmpty(AppConstants.MatrixLink))
            {
                <div class="link-container">
                    <img src="/icons/matrix.svg" />
                    <a href="@AppConstants.MatrixLink">Matrix</a>
                </div>
            }
            @if (!string.IsNullOrEmpty(AppConstants.SimplexLink))
            {
                <div class="link-container">
                    <img src="/icons/simplex.svg" />
                    <a href="@AppConstants.SimplexLink">SimpleX</a>
                </div>
            }
        </div>
    </div>
    <div class="node-section">
        <h5>Monero nodes</h5>
        <div class="space"></div>
        <ul class="url-connections">
            @foreach (var urlConnection in Model.UrlConnections.OrderByDescending(x => x.Url == Model.CurrentUrlConnection.Url).ThenBy(x => x.Priority))
            {
                <li class="@(urlConnection.Url == Model.CurrentUrlConnection.Url ? "connection connected" : "connection")">
                    @switch (urlConnection.OnlineStatus)
                    {
                        case Haveno.Shared.Enums.OnlineStatus.UNKNOWN:
                            <div class="online-status unknown"></div>
                            break;
                        case Haveno.Shared.Enums.OnlineStatus.ONLINE:
                            <div class="online-status online"></div>
                            break;
                        case Haveno.Shared.Enums.OnlineStatus.OFFLINE:
                            <div class="online-status offline"></div>
                            break;
                    }
                    <p class="url">@urlConnection.Url</p>
                    <form method="post" b-lpv6jm3h2x>
                        <input name="url" value="@urlConnection.Url" hidden />
                        <button disabled="@(urlConnection.Url == Model.CurrentUrlConnection.Url)" asp-page-handler="Connect" b-lpv6jm3h2x>
                            <i class="bi bi-arrow-right-circle connect-node"></i>
                        </button>
                    </form>
                    <form method="get">
                        <input name="NodeUrlToRemove" value="@urlConnection.Url" hidden />
                        <input name="IsRemoveModalOpen" value="true" hidden />
                        <button disabled="@(urlConnection.Url == Model.CurrentUrlConnection.Url)">
                            <i class="bi bi-x-circle remove-node"></i>
                        </button>
                    </form>
                </li>
            }
        </ul>
        <div class="toggle-container">
            <toggle submit-method="Model.OnPostAutoSwitchToggleAsync" is-toggled="IsAutoSwitchEnabled"></toggle>
            <label>Use any Monero node</label>
        </div>
        <form method="get" b-lpv6jm3h2x>
            <input name="IsAddModalOpen" value="true" hidden />
            <button class="button-primary add-node" b-lpv6jm3h2x>Add Monero node</button>
        </form>
    </div>
    <label>Currency</label>
    <dropdown value="Currency" values="Model.Currencies"></dropdown>
    <label>Language</label>
    <dropdown value="Language" values="Model.Languages"></dropdown>
    @if (AppConstants.IsDebug)
    {
        <form method="post" b-lpv6jm3h2x>
            <button class="button-primary" asp-page-handler="GetAlert">Get alert</button>
        </form>        
    }
</div>

<modal title="Add Monero node" submit-method="AddNode" is-open="@Model.IsAddModalOpen">
    <div class="url-input">
        <label>Node url</label>
        <input class="input-text" type="url" name="MoneroNodeUrl" value="@Model.MoneroNodeUrl" required />
        <p class="note">Example: http://192.168.0.1:18081</p>
    </div>
    <label>Authentication (optional)</label>
    <div>
        <label>Username</label>
        <input class="input-text" name="Username" value="@Model.Username" />
    </div>
    <div>
        <label>Password</label>
        <input class="input-text" type="password" name="Password" value="@Model.Password" />
    </div>
</modal>
<modal title="Remove Monero node" submit-method="RemoveNode" is-open="@Model.IsRemoveModalOpen">
    <p class="regular-p-grey">Are you sure you want to remove this Monero node?</p>
    <input name="NodeUrlToRemove" value="@Model.NodeUrlToRemove" hidden />
    <a class="external-link">Url: @Model.NodeUrlToRemove</a>
</modal>
