@model InfoRow
@{

}

<div class="info-row">
    <label>@Model.Label</label>
    <div class="inner-container inner-expanded">
        <p class="data">@Model.Value</p>
        @if (Model.IsExpandable)
        {
            <div class="check-container">
                <input type="checkbox" />
                <div class="eye"></div>
            </div>
        }
    </div>
</div>
