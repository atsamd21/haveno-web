@page
@inject IPriceService PriceService
@inject IPaymentAccountService PaymentAccountService
@model MyOffersModel
@{
    ViewData["Title"] = "My Offers";
}

<div class="my-offers-main">
    <eagertabs tab-index="@Model.TabIndex">
        <div class="tab" title="All">
            <ul>
                @* TODO make this a component *@
                @* TODO try to fix tab state *@
                @foreach (var offer in Model.Offers)
                {
                    if (!offer.UseMarketBasedPrice)
                    {
                        offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
                    }

                    <li>
                        <form method="post" class="view-info" b-2loocgleyk>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-route-TabIndex="@Model.TabIndex" asp-page-handler="ViewOfferInfo" b-2loocgleyk>
                                <i class="bi bi-info-circle"></i>
                                <p>@offer.Id.Split("-").First() | @offer.State</p>
                            </button>
                            <p class="payment-method">@offer.PaymentMethodShortName</p>
                        </form>
                        <div class="offer-body">
                            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
                            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
                            <p>@offer.CounterCurrencyCode amount: @(offer.CounterCurrencyVolume != offer.CounterCurrencyMinVolume ? $"{offer.CounterCurrencyMinVolume} -" : "") @offer.CounterCurrencyVolume @offer.CounterCurrencyCode</p>
                            <p>Price: @offer.Price.ToString(offer.IsFiat() ? "0.0000" : "0.00000000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2, MidpointRounding.AwayFromZero).ToString("0.00")%) @(offer.UseMarketBasedPrice ? "" : "(Fixed)")</p>
                        </div>
                        <form method="post" class="buttons" b-2loocgleyk>
                            <a href="@($"/Offers/{offer.Id}/EditOffer")" class="button-primary">Edit offer</a>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-page-handler="RemoveOffer" class="button-warning" b-2loocgleyk>Remove offer</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
        <div class="tab" title="Active">
            <ul>
                @foreach (var offer in Model.Offers.Where(x => x.State == OfferState.AVAILABLE))
                {
                    if (!offer.UseMarketBasedPrice)
                    {
                        offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
                    }

                    <li>
                        <form method="post" class="view-info" b-2loocgleyk>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-route-TabIndex="@Model.TabIndex" asp-page-handler="ViewOfferInfo" b-2loocgleyk>
                                <i class="bi bi-info-circle"></i>
                                <p>@offer.Id.Split("-").First() | @offer.State</p>
                            </button>
                            <p class="payment-method">@offer.PaymentMethodShortName</p>
                        </form>
                        <div class="offer-body">
                            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
                            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
                            <p>@offer.CounterCurrencyCode amount: @(offer.CounterCurrencyVolume != offer.CounterCurrencyMinVolume ? $"{offer.CounterCurrencyMinVolume} -" : "") @offer.CounterCurrencyVolume @offer.CounterCurrencyCode</p>
                            <p>Price: @offer.Price.ToString(offer.IsFiat() ? "0.0000" : "0.00000000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2, MidpointRounding.AwayFromZero).ToString("0.00")%) @(offer.UseMarketBasedPrice ? "" : "(Fixed)")</p>
                        </div>
                        <form method="post" class="buttons" b-2loocgleyk>
                            <a href="@($"/Offers/{offer.Id}/EditOffer")" class="button-primary">Edit offer</a>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-page-handler="RemoveOffer" class="button-warning" b-2loocgleyk>Remove offer</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
        <div class="tab" title="Inactive">
            <ul>
                @foreach (var offer in Model.Offers.Where(x => x.State == OfferState.DEACTIVATED))
                {
                    if (!offer.UseMarketBasedPrice)
                    {
                        offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
                    }

                    <li>
                        <form method="post" class="view-info" b-2loocgleyk>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-route-TabIndex="@Model.TabIndex" asp-page-handler="ViewOfferInfo" b-2loocgleyk>
                                <i class="bi bi-info-circle"></i>
                                <p>@offer.Id.Split("-").First() | @offer.State</p>
                            </button>
                            <p class="payment-method">@offer.PaymentMethodShortName</p>
                        </form>
                        <div class="offer-body">
                            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
                            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
                            <p>@offer.CounterCurrencyCode amount: @(offer.CounterCurrencyVolume != offer.CounterCurrencyMinVolume ? $"{offer.CounterCurrencyMinVolume} -" : "") @offer.CounterCurrencyVolume @offer.CounterCurrencyCode</p>
                            <p>Price: @offer.Price.ToString(offer.IsFiat() ? "0.0000" : "0.00000000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2, MidpointRounding.AwayFromZero).ToString("0.00")%) @(offer.UseMarketBasedPrice ? "" : "(Fixed)")</p>
                        </div>
                        <form method="post" class="buttons" b-2loocgleyk>
                            <a href="@($"/Offers/{offer.Id}/EditOffer")" class="button-primary">Edit offer</a>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-page-handler="RemoveOffer" class="button-warning" b-2loocgleyk>Remove offer</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </eagertabs>
    <a href="/Offers/CreateOffer" class="button-primary create-offer-button">Create offer</a>
</div>
<modal title="@($"Offer {Model.OfferInfo?.Id.Split("-").First()}")" is-open="IsOfferInfoModalOpen">
    @{
        var offer = Model.OfferInfo;

        if (offer is not null && !offer.UseMarketBasedPrice)
        {
            offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
        }

        // Cached so not that bad?
        var paymentAccounts = await PaymentAccountService.GetPaymentAccountsAsync();
    }
    @if (offer is not null)
    {
        var paymentAccount = paymentAccounts.FirstOrDefault(x => x.Id == offer.PaymentAccountId);

        <div class="offer-body">
            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
            <p>Trading account: @(paymentAccount?.AccountName)</p>
            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
            <p>@offer.CounterCurrencyCode amount: @(offer.CounterCurrencyVolume != offer.CounterCurrencyMinVolume ? $"{offer.CounterCurrencyMinVolume} -" : "") @offer.CounterCurrencyVolume @offer.CounterCurrencyCode</p>
            <p>Price: @offer.Price.ToString(offer.IsFiat() ? "0.0000" : "0.00000000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2, MidpointRounding.AwayFromZero).ToString("0.00")%)</p>
            @if (offer.TriggerPrice != 0)
            {
                <p>Trigger price: @offer.TriggerPrice.ToString("0.0000") @offer.CounterCurrencyCode</p>
            }
            <p>Buyer deposit: @(offer.BuyerSecurityDepositPercent * 100)%</p>
            <p>Seller deposit: @(offer.SellerSecurityDepositPercent * 100)%</p>
            <p>Status: @offer.State</p>
            @* <p>Status: @offer.State.ToString().ToLower()</p> *@
            @if (offer.BuyerSecurityDepositPercent == 0)
            {
                <div class="no-deposit">
                    <img src="/icons/warning.svg" />
                    <p>No deposit offer</p>
                </div>
            }
            else if (offer.IsPrivateOffer)
            {
                <div class="no-deposit">
                    <img src="/icons/warning.svg" />
                    <p>Passphrase required</p>
                </div>
            }
            <div class="toggle-container">
                <form method="post">
                    <input name="TabIndex" value="@Model.TabIndex" hidden/>
                    <input name="OfferId" value="@offer.Id" hidden/>
                    @if (offer.State == OfferState.AVAILABLE)
                    {
                        <button class="button-warning" asp-page-handler="DeactivateOffer">Deactivate offer</button>
                    }
                    else if (offer.State == OfferState.DEACTIVATED)
                    {
                        <button class="button-primary" asp-page-handler="ActivateOffer">Activate offer</button>
                    }
                </form>
            </div>
        </div>
    }
</modal>