@page "/Offers/{offerId}/EditOffer"
@model EditOfferModel
@{
    ViewData["Title"] = "Edit offer";

    var isFiat = Model.OfferInfo.PaymentMethodId != PaymentMethodId.BLOCK_CHAINS && Model.OfferInfo.PaymentMethodId != PaymentMethodId.BLOCK_CHAINS_INSTANT;
}

<div class="edit-offer-main">
    @switch (Model.Step)
    {
        case 0:
            <form method="post" class="first-step step-container" b-4zs7c8h0kh>
                <h5>Edit offer</h5>
                <div class="space"></div>
                @if (Model.OfferInfo.MinAmount == Model.OfferInfo.Amount)
                {
                    <partial name="_InfoRow" model="@(new InfoRow($"Amount to {(Model.OfferInfo.Direction == OfferDirection.BUY ? "buy" : "sell")}", $"{Model.OfferInfo.Amount.ToMonero().ToString("0.0000")} XMR"))" />
                }
                else
                {
                    <partial name="_InfoRow" model="@(new InfoRow($"Amount to {(Model.OfferInfo.Direction == OfferDirection.BUY ? "buy" : "sell")}", $"{Model.OfferInfo.MinAmount.ToMonero().ToString("0.0000")}" + " - " + $"{Model.OfferInfo.Amount.ToMonero().ToString("0.0000")} XMR"))" />
                }

                <label>@((Model.OfferInfo.Direction == OfferDirection.BUY ? "Below" : "Above") + " % from market price")</label>
                <input step="0.01" class="input-number" placeholder="Enter % value" type="number" min="-50" max="50" name="MarketPriceMarginPercent" value="@Model.MarketPriceMarginPercent" required="@Model.UseMarketBasedPrice" readonly="@(!Model.UseMarketBasedPrice)" />

                <label>Fixed price in @Model.OfferInfo.CounterCurrencyCode for 1 XMR</label>
                <input step="0.0001" class="input-number" placeholder="Enter price" type="number" name="PriceForOneXMR" value="@Model.PriceForOneXMR" required="@(!Model.UseMarketBasedPrice)" readonly="@Model.UseMarketBasedPrice" />

                <label>Use market based price</label>
                <toggle disabled="true" method="get" is-toggled="@Model.UseMarketBasedPrice"></toggle>

                <label>Amount in @Model.OfferInfo.CounterCurrencyCode to @(Model.OfferInfo.Direction == OfferDirection.BUY ? "spend" : "receive")</label>
                <div class="fiat-amount">
                    <input readonly class="input-number" min="0" name="FiatPriceForAmount" value="@Model.PriceForTotalAmount" />
                    <button class="button-primary"
                            type="submit"
                            asp-page-handler="Calculate" b-4zs7c8h0kh>
                        Calculate
                    </button>
                </div>

                <label>Deactivate offer if market price is @(Model.OfferInfo.Direction == OfferDirection.BUY ? "above" : "below")</label>
                <input step="0.0001" placeholder="Trigger price (optional)" class="input-number" min="0" type="number" name="TriggerPrice" value="@Model.TriggerPrice" disabled="@(!Model.UseMarketBasedPrice)" />

                <label>Extra information</label>
                <textarea class="textarea" name="ExtraInfo" placeholder="Any extra information">@Model.ExtraInfo</textarea>

                <input value="@Model.CurrencyCode" name="CurrencyCode" hidden />
                <input value="@Model.PaymentAccountId" name="PaymentAccountId" hidden />
                <input name="Price" value="@Model.Price" hidden />

                <input asp-for="HasLoaded" hidden />

                <button asp-page-handler="NextStep" class="button-continue" type="submit" b-4zs7c8h0kh>
                    Continue
                </button>
            </form>
            break;
        case 1:
            <form method="post" class="last-step step-container" b-4zs7c8h0kh>

                <input name="MarketPriceMarginPercent" value="@Model.MarketPriceMarginPercent" hidden />
                <input name="PriceForOneXMR" value="@Model.PriceForOneXMR" hidden />
                <input name="ExtraInfo" value="@Model.ExtraInfo" hidden />
                <input name="TriggerPrice" value="@Model.TriggerPrice" hidden />
                <input name="Price" value="@Model.Price" hidden />

@*                 <input name="CurrencyCode" value="@Model.CurrencyCode" hidden />
                <input name="PaymentAccountId" value="@Model.PaymentAccountId" hidden /> *@

                <input asp-for="UseMarketBasedPrice" hidden />

                <input asp-for="HasLoaded" hidden />

                <h5>Review offer edit</h5>
                <div class="space"></div>
                <div class="review-top">
                    <partial name="_InfoRow" model="@(new InfoRow("Trading account", Model.PaymentAccount.AccountName))" />
                    <div class="currency-code">
                        <partial name="_InfoRow" model="@(new InfoRow("Currency", Model.CurrencyCode))" />
                    </div>
                </div>
                <div class="review-offer-row">
                    @if (Model.OfferInfo.MinAmount == Model.OfferInfo.Amount)
                    {
                        <partial name="_InfoRow" model="@(new InfoRow($"Amount to {(Model.OfferInfo.Direction == OfferDirection.BUY ? "buy" : "sell")}", $"{Model.OfferInfo.Amount.ToMonero().ToString("0.0000")} XMR"))" />
                    }
                    else
                    {
                        <partial name="_InfoRow" model="@(new InfoRow($"Amount to {(Model.OfferInfo.Direction == OfferDirection.BUY ? "buy" : "sell")}", $"{Model.OfferInfo.MinAmount.ToMonero().ToString("0.0000")}" + " - " + $"{Model.OfferInfo.Amount.ToMonero().ToString("0.0000")} XMR"))" />
                    }

                    <div class="symbol">&#215;</div>

                    @if (Model.UseMarketBasedPrice)
                    {
                        <partial name="_InfoRow" model="@(new InfoRow(Model.OfferInfo.Direction == OfferDirection.BUY ? "" : "", $"{Model.MarketPriceMarginPercent.Value.ToString("0.00")}%"))" />
                    }
                    else
                    {
                        <partial name="_InfoRow" model="@(new InfoRow("Fixed price", $"{Model.PriceForOneXMR.Value.ToString("0.00")} {Model.CurrencyCode}"))" />
                    }

                    <div class="symbol">&#61;</div>

                    <partial name="_InfoRow" model="@(new InfoRow("Total", $"{Model.PriceForTotalAmount.Value.ToString(isFiat ? "0.00" : "0.00000000")} {Model.CurrencyCode}"))" />
                </div>
                <div class="buttons">
                    <button class="button-tertiary" asp-page-handler="PreviousStep" b-4zs7c8h0kh>
                        Previous step
                    </button>
                    <button class="button-primary" asp-page-handler="EditOffer" type="submit" b-4zs7c8h0kh>
                        Post offer
                    </button>
                </div>
            </form>
            break;
    }
</div>
