@page
@inject IPriceService PriceService;
@model MyOffersModel
@{
    ViewData["Title"] = "My Offers";
}

<div class="my-offers-main">
    <eagertabs tab-index="@Model.TabIndex">
        <div class="tab" title="All">
            <ul>
                @foreach(var offer in Model.Offers)
                {
                    if (!offer.UseMarketBasedPrice)
                    {
                        offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
                    }

                    <li>
                        <form method="post" class="view-info" b-7p3srnca82>
                            <input name="OfferId" value="@offer.Id" hidden/>
                            <button asp-route-TabIndex="@Model.TabIndex" asp-page-handler="ViewOfferInfo" b-7p3srnca82>
                                <i class="bi bi-info-circle"></i>
                                <p>@offer.Id.Split("-").First()</p>
                            </button>
                            <p class="payment-method">@offer.PaymentMethodShortName</p>
                        </form>
                        <div class="offer-body">
                            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
                            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
                            <p>@offer.CounterCurrencyCode amount: @(offer.FiatVolume != offer.FiatMinVolume ? $"{offer.FiatMinVolume} -" : "") @offer.FiatVolume @offer.CounterCurrencyCode</p>
                            <p>Price: @offer.Price.ToString("0.0000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2).ToString("0.00")%)</p>
                        </div>
                        <form method="post" class="buttons" b-7p3srnca82>
                            <a href="@($"EditOffer/{offer.Id}")" class="button-primary">Edit offer</a>
                            <input name="OfferId" value="@offer.Id" hidden />
                            <button asp-page-handler="RemoveOffer" class="button-warning" b-7p3srnca82>Remove offer</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
        <div class="tab" title="Active">

        </div>
        <div class="tab" title="Inactive">

        </div>
    </eagertabs>
    <a href="CreateOffer" class="button-primary create-offer-button">Create offer</a>
</div>
<modal title="@($"Offer {Model.OfferInfo?.Id.Split("-").First()}")" is-open="IsOfferInfoModalOpen">
    @{
        var offer = Model.OfferInfo;

        if (offer is not null && !offer.UseMarketBasedPrice)
        {
            offer.MarketPriceMarginPercent = (double)(await offer.GetFixedPricePercentageAsync(PriceService));
        }
    }
    @if (offer is not null)
    {
        <div class="offer-body">
            <p>@(offer.Direction == OfferDirection.BUY ? "Buying XMR" : "Selling XMR")</p>
            <p>XMR amount: @(offer.Amount != offer.MinAmount ? $"{offer.MinAmount.ToMonero().ToString("0.0000########")}ɱ -" : "") @offer.Amount.ToMonero().ToString("0.0000########")ɱ</p>
            <p>@offer.CounterCurrencyCode amount: @(offer.FiatVolume != offer.FiatMinVolume ? $"{offer.FiatMinVolume} -" : "") @offer.FiatVolume @offer.CounterCurrencyCode</p>
            <p>Price: @offer.Price.ToString("0.0000") (@Math.Round(offer.MarketPriceMarginPercent * 100, 2).ToString("0.00")%)</p>
            <p>Buyer deposit: @offer.BuyerSecurityDepositPercent%</p>
            <p>Seller deposit: @offer.SellerSecurityDepositPercent%</p>
            @if (offer.BuyerSecurityDepositPercent == 0)
            {
                <div class="no-deposit">
                    <img src="icons/warning.svg" />
                    <p>No deposit offer</p>
                </div>
            }
            else if (offer.IsPrivateOffer)
            {
                <div class="no-deposit">
                    <img src="icons/warning.svg" />
                    <p>Passphrase required</p>
                </div>
            }
        </div>
    }
</modal>