@page "{tradeId}"
@inject IStringLocalizer<TradeModel> Localizer
@inject IHtmlLocalizer<TradeModel> HtmlLocalizer
@model TradeModel
@{
    ViewData["Title"] = $"Trade {Model.TradeInfo.ShortId}";

    var requestCultureFeature = HttpContext.Features.Get<IRequestCultureFeature>();
    var requestCulture = requestCultureFeature?.RequestCulture;
}

<div class="trade-main">
    <div>
        <div class="trade-info">
            @{
                bool isCrypto = Model.TradeInfo.Offer.PaymentMethodId == PaymentMethodId.BLOCK_CHAINS || Model.TradeInfo.Offer.PaymentMethodId == PaymentMethodId.BLOCK_CHAINS_INSTANT;
            }

            @if (Model.TradeRoleAndStep.Role == Haveno.Api.Helpers.Role.Buyer)
            {
                <h5>Buying @Model.TradeInfo.Amount.ToMonero().ToString("0.0000########") XMR for @Model.TradeInfo.TradeVolume @Model.TradeInfo.Offer.CounterCurrencyCode @(isCrypto ? string.Empty : $"using {Model.TradeInfo.Offer.PaymentMethodShortName}")</h5>
            }
            else
            {
                <h5>Selling @Model.TradeInfo.Amount.ToMonero().ToString("0.0000########") XMR for @Model.TradeInfo.TradeVolume @Model.TradeInfo.Offer.CounterCurrencyCode @(isCrypto ? string.Empty : $"using {Model.TradeInfo.Offer.PaymentMethodShortName}")</h5>
            }
            <br />
            <div class="row">
                <p>ID</p>
                <p>@Model.TradeInfo.TradeId.Split('-').First()</p>
            </div>
            <div class="row">
                <p>Role</p>
                <p>@Model.TradeInfo.Role</p>
            </div>
            <div class="row">
                <p>Peer</p>
                <p>@Model.TradeInfo.TradePeerNodeAddress</p>
            </div>
        </div>
        @* <h5>Trade process</h5> *@
        <ul class="process">
            @for (int i = 0; i < 4; i++)
            {
                <li class="process-step">
                    @{
                        var stepCompletedOrCurrent = i < Model.TradeRoleAndStep.Step;
                    }

                    @if (i + 1 < Model.TradeRoleAndStep.Step)
                    {
                        <i class="@($"bi bi-check-circle-fill " + (stepCompletedOrCurrent ? "completed-step" : ""))"></i>
                    }
                    else
                    {
                        <i class="@($"bi bi-{i + 1}-circle" + (stepCompletedOrCurrent ? "-fill completed-step" : ""))"></i>
                    }

                    @if (Model.TradeRoleAndStep.Role == Haveno.Api.Helpers.Role.Buyer)
                    {
                        <p class="@(stepCompletedOrCurrent ? "completed-step" : "")">@Localizer[$"BUYER_STEP_{i + 1}"]</p>
                    }
                    else
                    {
                        <p class="@(stepCompletedOrCurrent ? "completed-step" : "")">@Localizer[$"SELLER_STEP_{i + 1}"]</p>
                    }

                </li>
            }
        </ul>
        @if (Model.TradeRoleAndStep.Role == Haveno.Api.Helpers.Role.Buyer)
        {
            if (Model.TradeRoleAndStep.Step == 2)
            {
                <form method="post" class="payment-info" b-7wnwtegkpd>
                    <h5>Send @Model.TradeInfo.TradeVolume @Model.TradeInfo.Offer.CounterCurrencyCode with @Model.TradeInfo.Offer.PaymentMethodShortName</h5>
                    <br />
                    @foreach (var keyVal in Model.TradeInfo.Offer.IsMyOffer ? Model.TradeInfo.Contract.TakerPaymentAccountPayload.Convert() : Model.TradeInfo.Contract.MakerPaymentAccountPayload.Convert())
                    {
                        <partial model="@(new InfoRow(keyVal.Key, string.IsNullOrEmpty(keyVal.Value) ? "N/A" : keyVal.Value, true))" name="_InfoRow" />
                    }
                    <button class="button-primary" asp-page-handler="ConfirmPaymentSent" type="submit">Confirm payment sent</button>
                </form>
            }
        }
        else
        {
            if (Model.TradeRoleAndStep.Step == 3)
            {
                <form method="post" class="payment-info" b-7wnwtegkpd>
                    <h5>Confirm receipt of @Model.TradeInfo.TradeVolume @Model.TradeInfo.Offer.CounterCurrencyCode</h5>
                    <br />
                    <h6>Peer's @Model.TradeInfo.Offer.PaymentMethodShortName account information</h6>
                    @foreach (var keyVal in Model.TradeInfo.Offer.IsMyOffer ? Model.TradeInfo.Contract.TakerPaymentAccountPayload.Convert() : Model.TradeInfo.Contract.MakerPaymentAccountPayload.Convert())
                    {
                        <partial model="@(new InfoRow(keyVal.Key, string.IsNullOrEmpty(keyVal.Value) ? "N/A" : keyVal.Value, true))" name="_InfoRow" />
                    }
                    <button class="button-primary" asp-page-handler="ConfirmPaymentReceived" type="submit" b-7wnwtegkpd>Confirm payment received</button>
                </form>
            }
        }

        <div>
            <partial model="@(new InfoRow("Your deposit transaction ID", Model.TradeInfo.TakerDepositTxId, true))" name="_InfoRow" />
            <partial model="@(new InfoRow("Peer's deposit transaction ID", Model.TradeInfo.MakerDepositTxId, true))" name="_InfoRow" />
            <partial model="@(new InfoRow("Trade deadline", (DateTime.UtcNow > Model.TradeInfo.DeadlineTime ? "Expired" : TimeHelper.FormatDuration((long)(Model.TradeInfo.DeadlineTime - DateTime.UtcNow).TotalMilliseconds)), true))" name="_InfoRow" />
        </div>
    </div>
    <form method="post" b-7wnwtegkpd>
        @if (Model.TradeRoleAndStep.Step == 4)
        {
            <button class="button-primary" asp-page-handler="CompleteTrade" type="submit" b-7wnwtegkpd>Close</button>
        }
    </form>
    <div class="buttons">
        <a class="button-tertiary" href=@($"/Messages/{Model.TradeInfo.TradeId}")>Trade chat</a>
        @if (Model.TradeInfo.DisputeState == Haveno.Api.Models.Enums.TradeDisputeState.NO_DISPUTE)
        {
            <form method="post" b-7wnwtegkpd>
                <button class="button-warning" asp-page-handler="OpenDispute" b-7wnwtegkpd>Open dispute</button>
            </form>
        }
        else
        {
            <form method="post" b-7wnwtegkpd>
                <button class="button-tertiary" asp-page-handler="ViewDispute" b-7wnwtegkpd>View dispute</button>
            </form>
        }
    </div>
</div>
