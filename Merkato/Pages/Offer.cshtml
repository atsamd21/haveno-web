@page "{offerId}"
@model OfferModel

@{
    ViewData["Title"] = $"Offer {Model.OfferInfo.Id.Split("-").First()}";
    var hasAmountRange = Model.OfferInfo.MinAmount != Model.OfferInfo.Amount;
}

<form method="post" class="offer-main" b-08enlyxma4>
    <p>@Model.OfferInfo.Id</p>
    <div class="payment-accounts">
        <select class="select" name="PaymentAccountId">
        @foreach (var paymentAccount in Model.PaymentAccounts)
        {
            <option 
                selected=@(@paymentAccount.Id == Model.PaymentAccountId)
                value="@paymentAccount.Id" b-08enlyxma4>
                @paymentAccount.AccountName
            </option>
        }
        </select>
    </div>
    <div class="offer-amount">
        <label>XMR Amount</label>
        @if (hasAmountRange)
        {
            <input
                class="input-text"
                type="number"
                step="0.000000000001"
                value="@Model.XmrAmount.ToString("F4")"
                min="@(hasAmountRange? Model.OfferInfo.MinAmount.ToMonero() : null)"
                max="@Model.OfferInfo.Amount.ToMonero()"
                name="XmrAmount" />
            <p class="note">Min/Max @Model.OfferInfo.MinAmount.ToMonero()XMR - @Model.OfferInfo.Amount.ToMonero()XMR</p>
        }
        else
        {
            <input
                readonly
                class="input-text"
                step="0.000000000001"
                type="number"
                value="@Model.XmrAmount.ToString("F4")"
                name="XmrAmount" />
        }
        <div>
            @if (Model.OfferInfo.IsPrivateOffer)
            {
                <p>Passphrase required</p>
            }
            @if (Model.OfferInfo.TakerFeePercent == 0)
            {
                <p>No deposit offer</p>
            }
        </div>
        <button class="button-primary" asp-page-handler="ReviewTakeOffer" type="submit" b-08enlyxma4>Review take offer</button>
    </div>
</form>
<modal is-open="@Model.IsModalOpen"
       title="Review offer" submit-method="TakeOffer">
    <input value="@Model.PaymentAccountId" name="PaymentAccountId" hidden />
    <input value="@Model.XmrAmount" name="XmrAmount" hidden />
    <p>Amount you are @(Model.OfferInfo.Direction == OfferDirection.BUY ? "selling" : "buying"): @Model.XmrAmount XMR</p>
</modal>