<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>

    <SimplexLink>https://smp4.simplex.im/g#hr4lvFeBmndWMKTwqiodPz3VBo_6UmdGWocXd1SupsM</SimplexLink>
    <MatrixLink>https://matrix.to/#/#haveno:monero.social</MatrixLink>
    <GitHubLink>https://github.com/atsamd21/haveno-web</GitHubLink>
    <HavenoTag>v1.11.0</HavenoTag>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <ApplicationVersion>0.0.1</ApplicationVersion>
  </PropertyGroup>

  <Target Name="BuildHaveno" BeforeTargets="BeforeBuild" Condition="'$(SkipHavenoBuild)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Running Haveno build in $(RepoRoot)" />
    <Exec Command="dotnet run build-haveno.cs -- $(HavenoTag)" WorkingDirectory="$(RepoRoot)" StandardOutputImportance="high" />
  </Target>

  <Target Name="IncludeJar" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="$(RepoRoot)haveno\daemon\build\libs\daemon-all.jar"
               Link="haveno\daemon-all.jar"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest"
               Condition="Exists('$(RepoRoot)haveno\daemon\build\libs\daemon-all.jar')" />
    </ItemGroup>
  </Target>

  <Target Name="CopyJar" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(RepoRoot)haveno\daemon\build\libs\daemon-all.jar" DestinationFolder="$(PublishDir)haveno" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>DaemonUrl</_Parameter1>
      <_Parameter2>$(DaemonUrl)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>SimplexLink</_Parameter1>
      <_Parameter2>$(SimplexLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>MatrixLink</_Parameter1>
      <_Parameter2>$(MatrixLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>GitHubLink</_Parameter1>
      <_Parameter2>$(GitHubLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>ApplicationVersion</_Parameter1>
      <_Parameter2>$(ApplicationVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Input\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="haveno-dotnet" Version="0.0.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Pages\AccountModel.en.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AccountModel.en.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Pages\AccountModel.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>AccountModel.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Pages\Trades\TradeModel.fr.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>TradeModel.fr.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Pages\Trades\TradeModel.en.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>TradeModel.en.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Pages\AccountModel.en.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AccountModel.en.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
