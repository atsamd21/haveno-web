<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>

    <SimplexLink>https://smp4.simplex.im/g#hr4lvFeBmndWMKTwqiodPz3VBo_6UmdGWocXd1SupsM</SimplexLink>
    <MatrixLink>https://matrix.to/#/#haveno:monero.social</MatrixLink>
    <GitHubLink>https://github.com/atsamd21/haveno-web</GitHubLink>
    <DaemonUrl>https://github.com/atsamd21/haveno/releases/download/v1.8.0</DaemonUrl>
    <ApplicationVersion>0.0.1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>DaemonUrl</_Parameter1>
      <_Parameter2>$(DaemonUrl)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>SimplexLink</_Parameter1>
      <_Parameter2>$(SimplexLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>MatrixLink</_Parameter1>
      <_Parameter2>$(MatrixLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>GitHubLink</_Parameter1>
      <_Parameter2>$(GitHubLink)</_Parameter2>
    </AssemblyAttribute>

    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>ApplicationVersion</_Parameter1>
      <_Parameter2>$(ApplicationVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Input\" />
    <Folder Include="wwwroot\fonts\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\haveno-dotnet-main\haveno-dotnet\haveno-dotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Pages\AccountModel.en.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AccountModel.en.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Pages\TradeModel.fr.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>TradeModel - Copy.en.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Pages\TradeModel.en.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>TradeModel.en.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Pages\AccountModel.en.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>AccountModel.en.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
